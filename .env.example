# ===== 应用 =====
PORT=3000
NODE_ENV=development
# 前端访问地址（CORS / PWA）
WEB_ORIGIN=http://localhost:5173

# ===== 数据库 (PostgreSQL) =====
DATABASE_URL=postgresql://myorgniz:myorgniz123@localhost:5432/myorgniz?schema=public

# ===== Redis（BullMQ 队列）=====
REDIS_URL=redis://localhost:6379

# ===== 认证 =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== 对象存储 (MinIO) =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=myorgniz

# ===== AI（首用 DeepSeek，OpenAI 兼容协议）=====
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-xxxxxxxx
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=60000
# 提示词日志目录（留空默认 <api 工作目录>/logs；每次调用写入 ai-prompts-YYYY-MM-DD.log，每天一个文件）
AI_PROMPT_LOG_DIR=

# ===== 站外链接基址（钉钉群/私聊、站内信里附带的“点击处理”链接）=====
# 留空默认 https://hzai.work；换域名时只改这里即可
APP_WEB_BASE_URL=

# ===== 钉钉（可选，不配置则不启用）=====
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 订阅群消息（Stream 模式），机器人需要被拉入对应群
DINGTALK_GROUPS=群1id,群2id
# 推送目标群（日报/周报/资讯推送）
DINGTALK_PUSH_GROUPS=群1id

# --- 钉钉群消息定时抓取（dws CLI，用户身份）---
# 抓取批次（北京时间；含 19:00 轮：让 20:00 的每日总结覆盖当天最新进展）
DINGTALK_FETCH_ENABLED=true
DINGTALK_FETCH_CRON=0 12,17,19 * * *
DINGTALK_FETCH_CRON_NIGHT=0 22 * * *
# dws.js 路径（默认自动探测）
DINGTALK_DWS_JS=

# --- 每日团队工作进展总结（20:00 私聊汇总 + 发各项目群）---
DINGTALK_DIGEST_ENABLED=true
# 触发时间（cron，北京时间每天 20:00）
DINGTALK_DIGEST_CRON=0 20 * * *
# 汇总私聊收件人（钉钉姓名；同名多人时改用钉钉 userId，如 0136635465841779）
DINGTALK_DIGEST_TO=杨力
# 私聊汇总中排除的项目名（逗号分隔；各项目群发送不受影响）
DINGTALK_DIGEST_EXCLUDE=项目push
# AI 生成金句失败时的兜底金句
DINGTALK_DIGEST_MOTTO_DEFAULT=做有心人，干困难事，立大格局

# --- 每日 AI 提示词日志发送（默认每天上午 8 点把前一天的 logs/ai-prompts-YYYY-MM-DD.log 私聊发给 DINGTALK_DIGEST_TO）---
DINGTALK_AI_LOG_ENABLED=true
DINGTALK_AI_LOG_CRON=0 8 * * *

# --- 会议提醒（meeting-reminder 队列）---
# 总开关：false 只停自动调度，开始提醒仍可在会议详情手动补发
MEETING_REMINDER_ENABLED=true
# 到点扫描（开始提醒 + 材料催办）：每 5 分钟；开始提醒与会议群通知豁免 20:00–07:00 禁发窗口
MEETING_REMINDER_TICK_CRON=*/5 * * * *
# 周会待发布提醒（冷启动首场私聊负责人）：每日 08:00 北京时间
MEETING_REMINDER_DAILY_CRON=0 8 * * *
# 钉钉消息里的会议详情域名前缀（默认生产域名）
MEETING_SITE_URL=https://hzai.work

# ===== Web Push（PWA 推送，可选）=====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=admin@example.com

# ===== 消息保留策略（天）=====
MESSAGE_RETENTION_DAYS=180
