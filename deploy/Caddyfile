# MyOrgNiz 反向代理配置（Caddy v2）
# 默认：内网/开发 HTTP 模式，Caddy 统一入口反代 api 与 web

:80 {
	encode gzip

	# 文档空间可上传 docx/pptx/xlsx/pdf/jpg/mp4/stl/zip/rar 等大文件，
	# Caddy 默认请求体上限 10MB，此处放宽到 512MB（超出返回 413）
	request_body {
		max_size 512MB
	}

	# API
	handle /api/* {
		reverse_proxy api:3000
	}

	# 前端静态资源（由 web 容器 nginx 提供，含 PWA）
	handle {
		reverse_proxy web:80
	}
}

# 生产环境启用 HTTPS 时，把 example.com 替换为你的域名，
# 删除上面 :80 块，启用下面配置（Caddy 会自动申请/续期证书）：
# example.com {
# 	encode gzip
# 	handle /api/* {
# 		reverse_proxy api:3000
# 	}
# 	handle {
# 		reverse_proxy web:80
# 	}
# }
